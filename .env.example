# Generate .env with: python3 scripts/setup_local.py
# These values are for the local Docker network, not host Python processes.
COMPOSE_PROJECT_NAME=streaming_analytics_system

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
ENVIRONMENT=development
PROJECT_NAME=Real-Time Streaming Analytics Platform
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Local platform services
POSTGRES_HOST=streaming-analytics-postgres
POSTGRES_PORT=5432
POSTGRES_DB=streaming_analytics
POSTGRES_USER=streaming_user
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_HOST=streaming-analytics-redis
REDIS_PORT=6379
REDIS_URL=redis://streaming-analytics-redis:6379/0
ELASTICSEARCH_HOST=http://streaming-analytics-elasticsearch:9200
STORAGE_SINK_LOG_LEVEL=INFO
ALERT_ENGINE_CONSUMER_GROUP=streaming-analytics-alert-engine
ALERT_ENGINE_LOG_LEVEL=INFO
ALERT_DEDUP_COOLDOWN_SECONDS=120
INCIDENT_CORRELATION_WINDOW_SECONDS=900
THREAT_INTEL_CONSUMER_GROUP=streaming-analytics-threat-intelligence
THREAT_INTEL_LOG_LEVEL=INFO
DETECTION_RULES_PATH=/app/rules
PROMETHEUS_URL=http://streaming-analytics-prometheus:9090
GRAFANA_URL=http://streaming-analytics-grafana:3000

# Observability metrics ports
ML_METRICS_PORT=9101
STORAGE_SINK_METRICS_PORT=9102
ALERT_ENGINE_METRICS_PORT=9103
PRODUCER_METRICS_PORT=9104
THREAT_INTEL_METRICS_PORT=9106

# Kafka telemetry runtime
KAFKA_BOOTSTRAP_SERVERS=streaming-analytics-kafka:29092
EVENT_RATE_PER_SECOND=5
ANOMALY_RATE=0.05
PRODUCER_LOG_LEVEL=INFO

# Spark Structured Streaming
SPARK_KAFKA_BOOTSTRAP_SERVERS=streaming-analytics-kafka:29092
SPARK_CHECKPOINT_ROOT=/opt/spark/checkpoints
SPARK_STARTING_OFFSETS=latest
SPARK_MAX_OFFSETS_PER_TRIGGER=5000
SPARK_TRIGGER_PROCESSING_TIME=15 seconds
SPARK_WATERMARK_DELAY=2 minutes
SPARK_LOG_LEVEL=WARN

# ML anomaly detection runtime
ML_CONSUMER_GROUP=streaming-analytics-ml-inference
ML_LOG_LEVEL=INFO
ML_ARTIFACT_DIR=/app/artifacts/contract-v2
ML_MODEL_NAME=isolation_forest_anomaly_detector
ML_MODEL_VERSION=0.2.0
ML_PREDICTION_TOPIC=ml.anomaly.predictions
ML_AUTO_BOOTSTRAP_MODEL=true
ML_TRAINING_SAMPLE_SIZE=12000
ML_CONTAMINATION=0.06

# Local host ports (choose unused values; container ports stay unchanged)
POSTGRES_PUBLISHED_PORT=5432
GRAFANA_PUBLISHED_PORT=3000
GRAFANA_ADMIN_PASSWORD=

# Optional VM-accessible source snapshot; default is this checkout.
DEV_BIND_ROOT=.

# Dashboard disclosure for the current event source.
VITE_EVENT_SOURCE=synthetic
VITE_ENABLE_THREAT_HUNTING=false
VITE_ENABLE_SYSTEM_HEALTH=false
VITE_ENABLE_OBSERVABILITY=false
